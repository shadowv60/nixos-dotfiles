/**
 * Abyss & Steel Theme
 */

* {
    /* Mapped to your cold mountain palette */
    bg0:     #1a1d24; /* Deep Base: The core background */
    bg1:     #343a47; /* Muted Slate: Input and selection backgrounds */
    border:  #5c677d; /* Dim Blue: The neutral bridge for borders */
    fg0:     #e2e8f0; /* Crisp Light: Brightest text/highlights */
    fg1:     #9db8d2; /* Steel Blue: Dimmer text, labels, and placeholders */
    accent:  #c5d3e8; /* Frost: Selected border highlight */
    
    background-color: transparent;
    text-color:        @fg0;
    margin:            0;
    padding:           0;
    spacing:           0;
}

window {
    background-color: @bg0;
    border:           2px;
    border-color:     @border;
    width:            500px;
    border-radius:    6px;
}

mainbox {
    children: [ inputbar, listview ];
}

inputbar {
    background-color: @bg1;
    children:         [ prompt, entry ];
    padding:          8px 12px;
}

prompt {
    text-color: @fg1;
    padding:    0 8px 0 0;
}

entry {
    placeholder:       "Search...";
    placeholder-color: @fg1;
    text-color:        @fg0;
}

listview {
    lines:        8;
    fixed-height: true;
    border:       1px 0 0;
    border-color: @border;
    spacing:      0px;
    scrollbar:    false;
    padding:      4px 0;
}

element {
    padding: 6px 12px;
}

element selected.normal {
    background-color: @bg1;
    text-color:        @fg0;
    /* Using Frost for the sharp left highlight indicator */
    border:           0 0 0 3px;
    border-color:     @accent;
}

element-text {
    background-color: inherit;
    text-color:        inherit;
    vertical-align:    0.5;
}

element-icon {
    size:              20px;
    padding:          0 8px 0 0;
}
