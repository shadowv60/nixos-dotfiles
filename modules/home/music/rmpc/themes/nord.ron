#![enable(implicit_some)]
#![enable(unwrap_newtypes)]
#![enable(unwrap_variant_newtypes)]

(
    default_album_art_path: None,
    format_tag_separator: " | ",
    browser_column_widths: [20, 38, 42],

    background_color: None,                 // Keeps terminal transparency intact
    text_color: "#e2e8f0",                  // Crisp Light text
    header_background_color: "#343a47",     // Muted Slate
    modal_background_color: "#1a1d24",      // Deep Base
    modal_backdrop: false,

    preview_label_style: (fg: "#5c677d"),   // Dim Blue labels
    preview_metadata_group_style: (fg: "#9db8d2", modifiers: "Bold"), // Steel Blue

    highlighted_item_style: (fg: "#9db8d2", modifiers: "Bold"),
    current_item_style: (fg: "#1a1d24", bg: "#9db8d2", modifiers: "Bold"), // High contrast active track

    borders_style: (fg: "#343a47"),         // Muted Slate boundaries
    highlight_border_style: (fg: "#5c677d"),

    symbols: (
        song: "S",
        dir: "D",
        playlist: "P",
        marker: "M",
        ellipsis: "...",
        song_style: None,
        dir_style: None,
        playlist_style: None,
    ),

    level_styles: (
        info:  (fg: "#5c677d", bg: "#1a1d24"),
        warn:  (fg: "#9db8d2", bg: "#1a1d24"),
        error: (fg: "#c5d3e8", bg: "#343a47", modifiers: "Bold"), // Frost highlight for errors
        debug: (fg: "#343a47", bg: "#1a1d24"),
        trace: (fg: "#343a47", bg: "#1a1d24"),
    ),

    progress_bar: (
        symbols: ["", "█", "", "", "" ],
        track_style: (fg: "#343a47"),       // Inactive bar background track
        elapsed_style: (fg: "#9db8d2"),     // Steel Blue filled track
        thumb_style: (fg: "#c5d3e8"),       // Frost leading indicator knob
        use_track_when_empty: true,
    ),

    cava: (
        bar_symbols: ['▁','▂','▃','▄','▅','▆','▇','█'],
        bar_width: 1,
        bar_spacing: 1,
        bg_color: None,

        bar_color: Gradient({
            0:   "#343a47",                 // Muted Slate at bottom
            33:  "#5c677d",                 // Dim Blue mid-layer
            66:  "#9db8d2",                 // Steel Blue upper peaks
            100: "#c5d3e8",                 // Frost white at clipping limits
        }),
    ),

    scrollbar: (
        symbols: ["│", "█", "▲", "▼"],
        track_style: (fg: "#1a1d24"),
        ends_style: (fg: "#343a47"),
        thumb_style: (fg: "#5c677d"),
    ),

    tab_bar: (
        active_style: (fg: "#1a1d24", bg: "#9db8d2", modifiers: "Bold"),
        inactive_style: (fg: "#5c677d"),
    ),

    lyrics: (
        timestamp: false
    ),

    components: {
        "state": Pane(Property(
            content: [
                (kind: Text("["), style: (fg: "#5c677d", modifiers: "Bold")),
                (kind: Property(Status(StateV2())), style: (fg: "#9db8d2", modifiers: "Bold")),
                (kind: Text("]"), style: (fg: "#5c677d", modifiers: "Bold")),
            ],
            align: Left,
        )),

        "title": Pane(Property(
            content: [
                (kind: Property(Song(Title)),
                    style: (fg: "#e2e8f0", modifiers: "Bold"),
                    default: (kind: Text("No Song"),
                        style: (fg: "#e2e8f0", modifiers: "Bold"))),
            ],
            align: Center,
            scroll_speed: 1,
        )),

        "volume": Pane(Property(
            content: [
                (kind: Text(" Vol: "), style: (fg: "#5c677d")),
                (kind: Property(Status(Volume)),
                    style: (fg: "#9db8d2", modifiers: "Bold")),
                (kind: Text("%"), style: (fg: "#5c677d")),
            ],
            align: Right,
        )),

        "elapsed_and_bitrate": Pane(Property(
            content: [
                (kind: Property(Status(Elapsed)), style: (fg: "#5c677d")),
                (kind: Text(" / "), style: (fg: "#343a47")),
                (kind: Property(Status(Duration)), style: (fg: "#5c677d")),
                (kind: Text(" ("), style: (fg: "#343a47")),
                (kind: Property(Status(Bitrate)), style: (fg: "#343a47")),
                (kind: Text(" kbps)"), style: (fg: "#343a47")),
            ],
            align: Left,
        )),

        "artist_and_album": Pane(Property(
            content: [
                (kind: Property(Song(Artist)),
                    style: (fg: "#9db8d2", modifiers: "Bold"),
                    default: (kind: Text("Unknown"),
                        style: (fg: "#9db8d2", modifiers: "Bold"))),
                (kind: Text(" - "), style: (fg: "#343a47")),
                (kind: Property(Song(Album)),
                    style: (fg: "#5c677d"),
                    default: (kind: Text("Unknown Album"),
                        style: (fg: "#5c677d"))),
            ],
            align: Center,
            scroll_speed: 1,
        )),

        "input_mode": Pane(Property(
            content: [
                (kind: Transform(Replace(
                    content: (kind: Property(Status(InputMode()))),
                    replacements: [
                        (
                            match: "Normal",
                            replace: (kind: Text(" NORMAL "),
                                style: (fg: "#1a1d24", bg: "#5c677d", modifiers: "Bold"))
                        ),
                        (
                            match: "Insert",
                            replace: (kind: Text(" INSERT "),
                                style: (fg: "#1a1d24", bg: "#9db8d2", modifiers: "Bold"))
                        ),
                    ]
                )))
            ],
            align: Center,
        )),

        "header_left": Split(
            direction: Vertical,
            panes: [
                (size: "1", pane: Component("state")),
                (size: "1", pane: Component("elapsed_and_bitrate")),
            ]
        ),

        "header_center": Split(
            direction: Vertical,
            panes: [
                (size: "1", pane: Component("title")),
                (size: "1", pane: Component("artist_and_album")),
            ]
        ),

        "header_right": Split(
            direction: Vertical,
            panes: [
                (size: "1", pane: Component("volume")),
                (size: "1", pane: Component("input_mode")),
            ]
        ),

        "progress_bar": Split(
            direction: Horizontal,
            panes: [
                (size: "1", pane: Pane(Empty())),
                (size: "100%", pane: Pane(ProgressBar)),
                (size: "1", pane: Pane(Empty())),
            ]
        ),
    },
)
